{
  "version": 1,
  "description": "Allocation Check rules. Edit this file to add, remove or re-weight SubCategories without touching code. Reloaded on every app run.",
  "rounding": {
    "basis": 2000000,
    "mode": "half_up",
    "divisor": 100,
    "_comment": "category_capital is rounded to the nearest `basis` (20,00,000) with halves going UP, then divided by `divisor` to give the expected allocation. mode must be one of: half_up, floor, ceil. half_up is deliberate: Python/numpy round() rounds halves to even, which turns 90,00,000 into 80,00,000 instead of 1,00,00,000."
  },
  "zero_sl": {
    "enabled": true,
    "sl_column": "sl",
    "max_loss_multiplier": 30
  },
  "_zero_sl_comment": "Accounts with a numeric ZERO in the All Users 'SL' column must satisfy max_loss = allocation x max_loss_multiplier. This checks MAX LOSS, not allocation, so it runs alongside the allocation rules rather than replacing them -- an account can appear on both its allocation rule sheet and the 0 SL sheet. A blank SL cell means 'no SL recorded' and is NOT checked. Scoped to the active DTE mode like every other rule.",

  "broker_rules": {
    "EXCELSTOCK": {
      "method": "capital_pct",
      "pct": 25
    },
    "VMATHRAMCO": {
      "method": "fix_allocation",
      "multiplier": 100000
    }
  },
  "_broker_rules_comment": "Per-broker overrides, matched on the All Users 'Broker' column (case-insensitive, exact name). Broker rules OUTRANK the FIX, Jainam and category rules, and are themselves outranked only by excluded_algos. method 'capital_pct' takes pct% of the Running file's capital and runs it through the normal rounding (EXCELSTOCK: 25%). method 'fix_allocation' derives the allocation straight from the FIX (CR) column: FIX 1 -> 1,00,000 (VMATHRAMCO). An account whose broker rule cannot be resolved -- no capital, or no FIX value -- is reported as 'Not under check' rather than being given an invented number. Editable from the app's Allocation Check screen.",
  "fix": {
    "enabled": true,
    "column": "fix_cr",
    "capital_multiplier": 10000000
  },
  "_fix_comment": "A positive value in the All Users 'FIX (CR)' column FIXES THE ACCOUNT'S CAPITAL instead of using the Running file's capital. FIX 1 means capital = 1,00,00,000 (capital_multiplier). The account's SubCategory percentage is then applied exactly as in the normal capital rule: fixed_capital x pct, rounded half-up to the rounding basis, divided by the divisor. So FIX 1 on a 40% category gives 1,00,00,000 -> 40,00,000 -> allocation 40,000. This overrides the running capital, the previous-day rule and the Jainam rule, but NOT an excluded algo. A blank cell means the account is not fixed. A populated but unusable value (0, negative, text) is reported as 'Not under check'. A FIX account whose SubCategory has no percentage (Jainam type, excluded, or unmapped) is also reported as 'Not under check' -- there is nothing to apply the fixed capital to.",
  "jainam": {
    "sheet_name": "Jainam",
    "userid_column": "UserID",
    "allocation_column": "ALLOCATION",
    "multiplier": 100000,
    "exclude_userids": [
      "total",
      "grand total",
      ""
    ]
  },
  "_jainam_comment": "Accounts whose SubCategory has action 'jexception' (JA) are checked against the 'Jainam' sheet inside the SAME All Users workbook, not against running capital. expected allocation = ALLOCATION x multiplier. ALLOCATION 0 means the expected allocation IS zero, so a non-zero Main allocation is a mismatch. All rows are used regardless of Date. exclude_userids drops the sheet's trailing Total row. A JA account with no row in the Jainam sheet is a mismatch. This check overrides the mode routing: a JA account never goes through the capital or previous-day path.",
  "excluded_servers": [
    "dlr acc",
    "not running"
  ],
  "_excluded_servers_comment": "Matched case-insensitively against the All Users `server` column. These accounts are never checked in any DTE mode.",
  "excluded_algos": [],
  "_excluded_algos_comment": "Algos listed here are skipped by every Allocation Check rule. They remain IN SCOPE and appear in the All Accounts table with status 'Not under check' and the remark 'Algo excluded by rule', so nothing disappears silently. Values are compared numerically, so 8, 8.0 and \"8\" all match. This exclusion has the highest precedence -- it applies before the FIX, Jainam, capital and previous-day rules. Editable from the app's Allocation Check screen.",
  "dte_filters": {
    "0DTE": {
      "runningtype": null,
      "runningdays": null,
      "_comment": "All userids except the excluded servers."
    },
    "1DTE": {
      "runningtype": [
        "pos"
      ],
      "runningdays": [
        "1dte/0dte",
        "daily"
      ]
    },
    "4DTE": {
      "runningtype": [
        "pos"
      ],
      "runningdays": [
        "daily"
      ]
    }
  },
  "_dte_filters_comment": "Values are compared lower-cased with spaces stripped. null means no filter on that column. NOTE: these are the Allocation Check filters and are intentionally independent of the Login Check filters in morning_comp.py (1DTE differs: no INT here).",
  "previous_day": {
    "required": [
      "0DTE"
    ],
    "optional": [
      "1DTE"
    ],
    "unused": [
      "4DTE"
    ]
  },
  "_previous_day_comment": "required = the check refuses to run without the previous-day All Users sheet. optional = the sheet changes how accounts are routed but is not mandatory. unused = the uploader is hidden.",
  "routing": {
    "0DTE": {
      "with_previous_day": [
        {
          "method": "capital",
          "runningtype": [
            "int"
          ]
        },
        {
          "method": "previous_day",
          "runningtype": [
            "pos"
          ]
        }
      ],
      "without_previous_day": []
    },
    "1DTE": {
      "with_previous_day": [
        {
          "method": "capital",
          "runningtype": [
            "pos"
          ],
          "runningdays": [
            "1dte/0dte"
          ]
        },
        {
          "method": "previous_day",
          "runningtype": [
            "pos"
          ],
          "runningdays": [
            "daily"
          ]
        }
      ],
      "without_previous_day": [
        {
          "method": "capital"
        }
      ]
    },
    "4DTE": {
      "with_previous_day": [
        {
          "method": "capital"
        }
      ],
      "without_previous_day": [
        {
          "method": "capital"
        }
      ]
    }
  },
  "_routing_comment": "Rules are evaluated in order against each in-scope account; the FIRST match wins. A rule with no runningtype/runningdays matches everything. method must be 'capital' (expected allocation derived from running capital) or 'previous_day' (today's allocation must equal the previous day's). Any in-scope account matching no rule is reported in the 'Cannot route' table rather than being silently dropped.",
  "subcategories": {
    "CC": {
      "action": "check",
      "pct": 100
    },
    "CCG": {
      "action": "check",
      "pct": 100
    },
    "CCV": {
      "action": "check",
      "pct": 60
    },
    "MSS": {
      "action": "check",
      "pct": 40
    },
    "MSV": {
      "action": "check",
      "pct": 60
    },
    "MSR": {
      "action": "check",
      "pct": 40
    },
    "MSP": {
      "action": "check",
      "pct": 40
    },
    "MSN": {
      "action": "check",
      "pct": 40
    },
    "PVT": {
      "action": "check",
      "pct": 100,
      "reason": "Excluded from expected-allocation calculation"
    },
    "PGB": {
      "action": "check",
      "pct": 100,
      "reason": "Excluded from expected-allocation calculation"
    },
    "PPS": {
      "action": "check",
      "pct": 100,
      "reason": "Excluded from expected-allocation calculation"
    },
    "PRD": {
      "action": "exclude",
      "pct": 0,
      "reason": "Excluded from expected-allocation calculation"
    },
    "MSJ": {
      "action": "jexception",
      "reason": "Checked against the Jainam sheet"
    },
    "MSRG": {
      "action": "check",
      "pct": 100
    }
  },
  "_subcategories_comment": "pct is a WHOLE PERCENT of running capital: 100 = 100%, 60 = 60%, 20 = 20%. pct 0 means the SubCategory is EXCLUDED from the check. Do NOT write 0.6 for 60% -- a value between 0 and 1 is rejected as a likely fraction mistake. action must be one of: check (needs pct), exclude, jexception (checked against the Jainam sheet instead). Any SubCategory found in the sheet but absent from this map is reported in the 'Unknown SubCategory' table and is never silently dropped. This section is editable from the app's Allocation Check screen."
}
